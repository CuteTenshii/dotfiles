{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/block-git-push-skip-hooks\"",
            "timeout": 10,
            "statusMessage": "Checking git push for skipped hooks"
          }
        ]
      }
    ]
  }
}
