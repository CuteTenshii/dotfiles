#!/bin/sh
# pre-push: refuse your unsigned commits (not yet on any remote) and unsigned
# annotated tags, e.g. after filter-branch drops signatures.

me=$(git config user.email)
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_oid" = "$zero" ]; then
        continue
    fi

    if [ "$(git cat-file -t "$local_oid")" = tag ] && ! git verify-tag "$local_oid" >/dev/null 2>&1; then
        echo "pre-push: tag $local_ref has no good signature; re-create it with git tag -f -s" >&2
        status=1
    fi

    # G/U: good signature; X/Y: good, but expired since.
    unsigned=$(git log --format='%ce%x09%G? %h %s' "$local_oid" --not --remotes |
        awk -F '\t' -v me="$me" '$1 == me && $2 !~ /^[GUXY] / { print "  " $2 }')
    if [ -n "$unsigned" ]; then
        echo "pre-push: $local_ref has commits without a good signature:" >&2
        echo "$unsigned" >&2
        echo "pre-push: re-sign them with git rebase --force-rebase -S <base>" >&2
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: or push with --no-verify to skip this check" >&2
fi
exit "$status"
