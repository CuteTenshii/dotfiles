#!/bin/sh
# commit-msg: require a Conventional Commits header, <type>(<scope>)!: <subject>.
# Messages git writes itself (merges, reverts, fixup!/squash!/amend!) pass.

types='feat|fix|refactor|docs|test|chore|perf|build|ci'

comment=$(git config core.commentString || git config core.commentChar || echo '#')
if [ "$comment" = auto ]; then
    comment='#'
fi

header=$(awk -v c="$comment" 'index($0, c) != 1 && NF { print; exit }' "$1")

# Leave an empty message to git, which aborts the commit with its own error.
if [ -z "$header" ]; then
    exit 0
fi

case $header in
    'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*)
        exit 0
        ;;
esac

if printf '%s\n' "$header" | grep -Eq "^($types)(\([^()[:space:]]+\))?!?: [^[:space:]](.*[^.])?\$"; then
    exit 0
fi

cat >&2 <<EOF
commit-msg: header is not a Conventional Commit:
  $header
expected <type>(<scope>): <subject>, with an optional scope and ! for breaking changes
  types: $(printf '%s' "$types" | sed 's/|/, /g')
  subject: no trailing period
commit-msg: or commit with --no-verify to skip this check
EOF
exit 1
