* {
    bg:          rgba(20, 22, 24, 88%);
    bg-input:    rgba(255, 255, 255, 6%);
    fg:          #ffffff;
    fg-muted:    #a6a9b0;
    accent:      #c084fc;
    selected-bg: rgba(146, 110, 228, 30%);
    urgent:      #eb4d4b;

    font:             "Segoe UI Variable Static Text 12";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    width:            620px;
    background-color: @bg;
    border:           2px;
    border-color:     rgba(192, 132, 252, 67%);
    border-radius:    4px;
    padding:          14px;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing:  10px;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @bg-input;
    border-radius:    4px;
    padding:          10px 12px;
    spacing:          10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-muted;
    cursor:            text;
}

message {
    background-color: @bg-input;
    border-radius:    4px;
    padding:          8px 12px;
}

textbox {
    text-color: @fg-muted;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element {
    padding:       7px 10px;
    spacing:       12px;
    border-radius: 4px;
    cursor:        pointer;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element selected.normal,
element selected.active {
    background-color: @selected-bg;
    text-color:       @fg;
}

element selected.urgent {
    background-color: @urgent;
    text-color:       @fg;
}

element-icon {
    size:             28px;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold;
    cursor:           inherit;
}

mode-switcher {
    spacing: 6px;
}

button {
    padding:       6px;
    border-radius: 4px;
    text-color:    @fg-muted;
    cursor:        pointer;
}

button selected {
    background-color: @selected-bg;
    text-color:       @fg;
}
